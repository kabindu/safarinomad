# Copy this file to .env (same folder) and fill in a key. Restart `npm run dev` after editing.
# .env is private: it is listed in .gitignore and never committed.

# --- AI assistant "Nomad" (and automatic translations) ---
# Free option: Google Gemini. Get a key at https://aistudio.google.com/apikey
# (Google's free tier has daily limits, and Google may use free-tier conversations to improve its products.)
GEMINI_API_KEY=
# Optional: another Gemini model (default: gemini-3.8-flash, the best model on the free tier)
# GEMINI_MODEL=gemini-3.8-flash

# Paid option with live web search: Anthropic Claude. Get a key at https://platform.claude.com
# If both keys are set, Claude is used. Force one with AI_PROVIDER=gemini or AI_PROVIDER=claude.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini

# --- Admin ---
# Optional: change the admin password without editing server/data/admin-password.txt
# ADMIN_PASSWORD=
